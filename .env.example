# Servidor
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info

# Banco de dados
DATABASE_URL=postgres://beacon:beacon@localhost:5433/beacon

# Autenticação do painel (troque em produção: openssl rand -hex 32)
JWT_SECRET=troque-este-valor-por-uma-chave-aleatoria-de-32-bytes
JWT_EXPIRES_IN=1h

# Ingestão
MAX_EVENTS_PER_BATCH=500
INGEST_RATE_LIMIT_PER_MINUTE=6000
